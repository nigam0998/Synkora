# ══════════════════════════════════════════════════════════════════════
# Synkora — Environment Configuration
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.
# ══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
APP_NAME=Synkora API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synkora

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GitHub OAuth ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ── Google Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Repository Storage ───────────────────────────────────────────────
REPO_STORAGE_PATH=./storage/repos
MAX_REPO_SIZE_MB=500

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
